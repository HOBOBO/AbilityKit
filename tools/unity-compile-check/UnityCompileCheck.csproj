<Project Sdk="Microsoft.NET.Sdk">

  <!-- 模拟 Unity 2022.3 编译环境（netstandard2.1 + C# 9），按 asmdef 边界拆分工程互相引用，
       验证 behaviortree 包与 demo BTree 源码在 Unity 下可编译。根工程：编排全部检查。
       分工程的意义：Unity asmdef 引用不传递，单工程合并编译会掩盖缺引用错误。 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="DeterministicCheck.csproj" />
    <ProjectReference Include="RuntimeCheck.csproj" />
    <ProjectReference Include="EditorCheck.csproj" />
    <ProjectReference Include="DemoBTreeCheck.csproj" />
  </ItemGroup>

</Project>
