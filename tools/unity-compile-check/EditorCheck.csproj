<Project Sdk="Microsoft.NET.Sdk">

  <!-- 镜像 asmdef: AbilityKit.BehaviorTree.Editor（Editor-only，引用同 Runtime 的 asmdef 引用集） -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <NoWarn>CS8632;CS8981</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <UnityManaged>C:\Program Files\Unity\Hub\Editor\2022.3.62f1\Editor\Data\Managed</UnityManaged>
    <RepoRoot>C:\Workspace\gitProject\AbilityKit</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)\Unity\Packages\com.abilitykit.behaviortree\Editor\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="RuntimeCheck.csproj" />
    <ProjectReference Include="DeterministicCheck.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AbilityKit.Editor.Platform">
      <HintPath>$(RepoRoot)\Unity\Library\ScriptAssemblies\AbilityKit.Editor.Platform.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEditor.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEditor.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEditor.UIElementsModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEditor.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEditor.GraphViewModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEditor.GraphViewModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEditor.QuickSearchModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEditor.QuickSearchModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
