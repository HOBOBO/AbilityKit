      "placeholderAllowlist": [
        {
          "id": 90000101,
          "owner": "MOBA Presentation",
          "reason": "Existing shared circular AOE preview mesh; replace with production-owned area presentation."
        },
        {
          "id": 90000102,
          "owner": "MOBA Presentation",
          "reason": "Existing shared sector AOE preview mesh; replace with production-owned area presentation."
        }
      ],
      "resourceRoot": "Unity/Packages/com.abilitykit.demo.moba.view.runtime/Resources",
      "extensions": [".prefab"],
      "severity": "warning",
      "productionReachableSeverity": "error"
    },
    {
      "table": "vfx",
      "path": "Resource",
      "required": true,
      "placeholderPatterns": [
        "(^|[\\/])placeholders?([\\/]|$)"
