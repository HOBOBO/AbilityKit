<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbilityKit.BattleScenario\AbilityKit.BattleScenario.csproj" />
    <ProjectReference Include="..\AbilityKit.World.StateSync\AbilityKit.World.StateSync.csproj" />
    <ProjectReference Include="..\AbilityKit.Network.Runtime\AbilityKit.Network.Runtime.csproj" />
    <Compile Include="../../Unity/Packages/com.abilitykit.world.statesync/Samples~/LocalCheckpoints/LocalCheckpointExample.cs"
             Link="Samples/LocalCheckpointExample.cs" />
    <Compile Include="../../Unity/Packages/com.abilitykit.world.statesync/Samples~/LocalSnapshotHistory/LocalSnapshotHistoryExample.cs"
             Link="Samples/LocalSnapshotHistoryExample.cs" />
    <Compile Include="../../Unity/Packages/com.abilitykit.world.statesync/Samples~/LocalStateCommit/LocalStateCommitExample.cs"
             Link="Samples/LocalStateCommitExample.cs" />
    <None Update="Samples/Scenarios/*.battlescenario" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
