<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AbilityKitStable>true</AbilityKitStable>
    <Nullable>enable</Nullable>
    <RootNamespace>AbilityKit.Modifiers</RootNamespace>
    <AssemblyName>AbilityKit.Modifiers</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 引用 Packages 目录下的源码 -->
  <ItemGroup>
    <Compile Include="../../Unity/Packages/com.abilitykit.modifiers/Runtime/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 衰减曲线的 exp/ln 走 DeterministicMathBridge（float 进出、定点内核） -->
    <ProjectReference Include="../AbilityKit.Core/AbilityKit.Core.csproj" />
  </ItemGroup>
</Project>
