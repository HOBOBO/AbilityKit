<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AbilityKitStable>true</AbilityKitStable>
    <Nullable>enable</Nullable>
    <RootNamespace>AbilityKit.Pipeline</RootNamespace>
    <AssemblyName>AbilityKit.Pipeline</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RS0026</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AbilityKit.Core/AbilityKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <!--
    复用 UPM 包的运行时源码。Pipeline.cs 包含 Unity 场景加载钩子，仅由 Unity 编译；
    .NET 编译本工程的同名门面，保留显式 Initialize()，不带 Unity 场景加载钩子。
  -->
  <ItemGroup>
    <Compile Include="../../Unity/Packages/com.abilitykit.pipeline/Runtime/**/*.cs" Exclude="../../Unity/Packages/com.abilitykit.pipeline/Runtime/Pipeline.cs" />
  </ItemGroup>

</Project>
