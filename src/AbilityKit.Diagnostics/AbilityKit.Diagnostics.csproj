<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AbilityKit.Diagnostics</RootNamespace>
    <AssemblyName>AbilityKit.Diagnostics</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 复用平台无关的运行时代码，不编译 Unity 采样适配。 -->
  <ItemGroup>
    <Compile Include="../../Unity/Packages/com.abilitykit.diagnostics/Runtime/**/*.cs"
             Exclude="../../Unity/Packages/com.abilitykit.diagnostics/Runtime/Unity/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AbilityKit.Core/AbilityKit.Core.csproj" />
  </ItemGroup>

</Project>
