<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AbilityKitStable>true</AbilityKitStable>
    <RootNamespace>AbilityKit.Core</RootNamespace>
    <AssemblyName>AbilityKit.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <!--
    0.1.0 Beta 发版时，可空性标注未全覆盖，以下 CS8xxx 按核心包范围单独列为 NoWarn。
    每条注释为当前剩余数量；随对应代码依次修复后，从本列表移除对应条目。
    本列表解决后，根 Directory.Build.props 的 WarningsNotAsErrors 即可移除对应 CS8xxx。
  -->
  <!-- 引用 Unity Package 中的纯运行时源码，Unity 专属桥接代码由 UPM asmdef 编译。 -->
  <ItemGroup>
    <Compile Include="../../Unity/Packages/com.abilitykit.core/Runtime/**/*.cs" Exclude="../../Unity/Packages/com.abilitykit.core/Runtime/Unity/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbilityKit.Deterministic\AbilityKit.Deterministic.csproj" />
  </ItemGroup>
</Project>
