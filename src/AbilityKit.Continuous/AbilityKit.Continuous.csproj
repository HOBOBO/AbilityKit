<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AbilityKitStable>true</AbilityKitStable>
    <RootNamespace>AbilityKit.Continuous</RootNamespace>
    <AssemblyName>AbilityKit.Continuous</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Unity/Packages/com.abilitykit.continuous/Runtime/**/*.cs"
             Exclude="../../Unity/Packages/com.abilitykit.continuous/Runtime/**/*.asmdef" />
  </ItemGroup>
</Project>
