<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AbilityKit</RootNamespace>
    <AssemblyName>AbilityKit.Host.Network</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Unity/Packages/com.abilitykit.host.network/Runtime/**/*.cs"
             Exclude="../../Unity/Packages/com.abilitykit.host.network/Runtime/**/*.asmdef" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AbilityKit.Host/AbilityKit.Host.csproj" />
    <ProjectReference Include="../AbilityKit.Network.Host/AbilityKit.Network.Host.csproj" />
  </ItemGroup>
</Project>
