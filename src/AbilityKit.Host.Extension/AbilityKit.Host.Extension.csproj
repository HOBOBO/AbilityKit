<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AbilityKitStable>true</AbilityKitStable>
    <RootNamespace>AbilityKit.Ability.Host.Extensions</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DOTNET</DefineConstants>
  </PropertyGroup>

  <!-- 通用 host.extension 运行时文件（Moba 专属 host adapter 已提取至 com.abilitykit.demo.moba.host）。 -->
  <ItemGroup>
    <Compile Include="..\..\Unity\Packages\com.abilitykit.host.extension\Runtime\Server\BattleHost\*.cs" />
    <Compile Include="..\..\Unity\Packages\com.abilitykit.host.extension\Runtime\Client\FrameSync\*.cs" />
    <Compile Include="..\..\Unity\Packages\com.abilitykit.host.extension\Runtime\FrameSync\*.cs" />
    <Compile Include="..\..\Unity\Packages\com.abilitykit.host.extension\Runtime\Rollback\*.cs" />
    <Compile Include="..\..\Unity\Packages\com.abilitykit.host.extension\Runtime\Session\*.cs" />
    <Compile Include="..\..\Unity\Packages\com.abilitykit.host.extension\Runtime\Time\*.cs" />
    <Compile Include="..\..\Unity\Packages\com.abilitykit.host.extension\Runtime\WorldStart\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbilityKit.Host\AbilityKit.Host.csproj" />
    <ProjectReference Include="..\AbilityKit.Network.Runtime\AbilityKit.Network.Runtime.csproj" />
    <ProjectReference Include="..\AbilityKit.World.NetworkFragments\AbilityKit.World.NetworkFragments.csproj" />
    <ProjectReference Include="..\AbilityKit.World.Snapshot\AbilityKit.World.Snapshot.csproj" />
    <ProjectReference Include="..\AbilityKit.Timer\AbilityKit.Timer.csproj" />
  </ItemGroup>

</Project>
